  {"id":"jellyfish_01","name":"\uB178\uBB34\uB77C\uC785\uAE43\uD574\uD30C\uB9AC","dangerLevel":"\uC704\uD5D8","description":"\uB300\uD615 \uD574\uD30C\uB9AC\uB85C \uCD09\uC218\uC5D0 \uB3C5\uC131\uC774 \uC788\uC744 \uC218 \uC788\uC2B5\uB2C8\uB2E4.","guidance":"\uBB3C \uBC16\uC73C\uB85C \uC774\uB3D9\uD558\uACE0 \uC8FC\uBCC0 \uC0AC\uB78C\uC5D0\uAC8C \uC54C\uB9AC\uC138\uC694.","firstAid":["\uBB3C \uBC16\uC73C\uB85C \uC774\uB3D9\uD558\uACE0 \uC548\uC804\uC694\uC6D0\uC5D0\uAC8C \uC54C\uB9BD\uB2C8\uB2E4.","\uD658\uBD80\uB97C \uBB38\uC9C0\uB974\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.","\uD638\uD761\uACE4\uB780\uC774\uB098 \uC2EC\uD55C \uD1B5\uC99D\uC774 \uC788\uC73C\uBA74 \uC989\uC2DC 119\uC5D0 \uC2E0\uACE0\uD569\uB2C8\uB2E4."]},
  {"id":"box_jellyfish","name":"\uC791\uC740\uC0C1\uC790\uD574\uD30C\uB9AC","dangerLevel":"\uB9E4\uC6B0 \uC704\uD5D8","description":"\uC791\uC9C0\uB9CC \uAC15\uD55C \uD1B5\uC99D\uC744 \uC77C\uC73C\uD0AC \uC218 \uC788\uB294 \uB9F9\uB3C5\uC131 \uD574\uD30C\uB9AC\uB958\uC785\uB2C8\uB2E4.","guidance":"\uB9E8\uC190\uC73C\uB85C \uB9CC\uC9C0\uC9C0 \uB9D0\uACE0 \uC989\uC2DC \uC548\uC804\uC694\uC6D0\uC5D0\uAC8C \uC54C\uB9AC\uC138\uC694.","firstAid":["\uC989\uC2DC \uBB3C \uBC16\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4.","\uBC14\uB2F7\uBB3C\uB85C \uC870\uC2EC\uC2A4\uB7FD\uAC8C \uC53B\uACE0 \uBB38\uC9C0\uB974\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.","\uD638\uD761\uACE4\uB780\uC774\uB098 \uC5B4\uC9C0\uB7FC\uC774 \uC788\uC73C\uBA74 \uC989\uC2DC 119\uC5D0 \uC2E0\uACE0\uD569\uB2C8\uB2E4."]},
  {"id":"blue_ring_octopus","name":"\uD30C\uB780\uC120\uBB38\uC5B4","dangerLevel":"\uADF9\uC704\uD5D8","description":"\uD14C\uD2B8\uB85C\uB3C4\uD1A1\uC2E0\uC744 \uC9C0\uB140 \uB9C8\uBE44\uB098 \uD638\uD761\uACE4\uB780\uC744 \uC77C\uC73C\uD0AC \uC218 \uC788\uC2B5\uB2C8\uB2E4.","guidance":"\uC808\uB300 \uB9CC\uC9C0\uC9C0 \uB9D0\uACE0 \uC8FC\uBCC0\uC744 \uD1B5\uC81C\uD55C \uB4A4 \uC2E0\uACE0\uD558\uC138\uC694.","firstAid":["\uBB3C\uB9B0 \uBD80\uC704\uB97C \uC6C0\uC9C1\uC774\uC9C0 \uC54A\uAC8C \uD558\uACE0 \uD3B8\uC548\uD788 \uB205\uD799\uB2C8\uB2E4.","\uD638\uD761\uACFC \uC758\uC2DD\uC744 \uAD00\uCC30\uD558\uBA70 \uC989\uC2DC 119\uC5D0 \uC2E0\uACE0\uD569\uB2C8\uB2E4."]},
  {"id":"sting_fish","name":"\uC3E0\uC885\uAC1C","dangerLevel":"\uC704\uD5D8","description":"\uC9C0\uB290\uB7EC\uBBF8 \uB3C5\uAC00\uC2DC\uC5D0 \uCC14\uB9AC\uBA74 \uC2EC\uD55C \uD1B5\uC99D\uACFC \uBD80\uC885\uC774 \uC0DD\uAE38 \uC218 \uC788\uC2B5\uB2C8\uB2E4.","guidance":"\uB9E8\uBC1C\uB85C \uBC14\uC704\uD2C8\uC744 \uAC77\uC9C0 \uB9D0\uACE0 \uC548\uC804\uD654\uB97C \uCC29\uC6A9\uD558\uC138\uC694.","firstAid":["\uAC00\uC2DC\uB97C \uC5B5\uC9C0\uB85C \uBE7C\uC9C0 \uC54A\uC2B5\uB2C8\uB2E4.","\uC2EC\uD55C \uD1B5\uC99D\uC774\uB098 \uC54C\uB808\uB974\uAE30 \uC99D\uC0C1\uC740 119\uC5D0 \uC5F0\uB77D\uD569\uB2C8\uB2E4."]},
  {"id":"lionfish","name":"\uAC2F\uBC14\uC704 \uC3E0\uBC30\uAC10\uD3AD","dangerLevel":"\uC704\uD5D8","description":"\uB4F1\uC9C0\uB290\uB7EC\uBBF8 \uB3C5\uAC00\uC2DC\uC5D0 \uCC14\uB9AC\uBA74 \uC2EC\uD55C \uD1B5\uC99D\uC744 \uC720\uBC1C\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4.","guidance":"\uAC2F\uBC14\uC704\uC640 \uBC29\uD30C\uC81C \uC8FC\uBCC0\uC5D0\uC11C\uB294 \uB9E8\uC190\uC73C\uB85C \uB9CC\uC9C0\uC9C0 \uB9C8\uC138\uC694.","firstAid":["\uBB3C \uBC16 \uC548\uC804\uD55C \uACF3\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4.","\uAC00\uC2DC\uB97C \uC5B5\uC9C0\uB85C \uBE7C\uC9C0 \uB9D0\uACE0 \uC758\uB8CC\uAE30\uAD00\uC73C\uB85C \uC774\uB3D9\uD569\uB2C8\uB2E4."]}
